# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo .env NÃO vai para o Git (está no .gitignore).

# Porta do servidor web
PORT=3000

# Endereço em que o servidor escuta.
# 127.0.0.1 = só este computador (mais seguro).
# 0.0.0.0   = qualquer aparelho da mesma rede Wi-Fi (ex.: abrir no celular).
HOST=127.0.0.1

# Caminho do banco SQLite (a pasta é criada automaticamente)
DB_PATH=./data/escritorio.db

# Pasta onde o Dev salva as prévias em HTML
PASTA_PREVIAS=./previas

# Velocidade inicial da simulação (1, 2 ou 4)
VELOCIDADE_INICIAL=1

# Site da BLUE ROSE (usado nas propostas e mensagens)
SITE_URL=https://cauacaetano.github.io/blue-rose-automacao-express/

# --- IA real (API da Anthropic) ---
# Cole aqui a sua chave (começa com sk-ant-). Deixe vazio para o modo simulado.
ANTHROPIC_API_KEY=

# Modelo usado pelos agentes. Padrão: claude-opus-5-5 (o mais capaz da linha Opus).
# Mais barato: claude-sonnet-5-5 | Ainda mais barato: claude-haiku-4-5
MODELO_IA=claude-opus-5-5

# Esforço de raciocínio: low (mais rápido/barato), medium (equilíbrio) ou high
ESFORCO_IA=medium

# --- Supabase (opcional): espelho dos dados na nuvem ---
# Supabase → Project Settings → API. Use a chave "service_role" (secreta, só no servidor).
# Antes, rode o arquivo supabase/schema.sql no SQL Editor do Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
